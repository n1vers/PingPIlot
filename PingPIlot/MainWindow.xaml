<Window x:Class="PingPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PingPilot"
        Title="PingPilot"
        Height="800" Width="1280"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        StateChanged="MainWindow_StateChanged"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <!-- Плашка «имя интерфейса + адрес»: для Local IP и шлюза. Клик копирует адрес. -->
        <DataTemplate x:Key="AddressChipTemplate">
            <Border BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,4"
                    Margin="0,0,6,4"
                    Cursor="Hand"
                    ToolTip="Нажмите, чтобы скопировать IP-адрес"
                    Tag="{Binding Address}"
                    MouseLeftButtonUp="LocalIpChip_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Background" Value="#263B82F6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="14"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Address}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <TabControl x:Name="MainTabs" Style="{StaticResource MainTabControl}">
        <!-- Масштаб интерфейса: Ctrl + колесо мыши, Ctrl + «+» / «-», Ctrl + 0 — сбросить. -->
        <TabControl.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
        </TabControl.LayoutTransform>

        <!-- IP-адреса этого компьютера и текущий шлюз: в шапке приложения, видны на любой вкладке.
             Клик по адресу копирует его. -->
        <TabControl.Tag>
            <WrapPanel Orientation="Horizontal"
                       VerticalAlignment="Center"
                       MaxWidth="780">
                <TextBlock Text="Local IP"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4"/>
                <ItemsControl x:Name="LocalIpList" MaxWidth="420"
                              ItemTemplate="{StaticResource AddressChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="Шлюз"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="10,0,8,4"/>
                <ItemsControl x:Name="GatewayList" MaxWidth="260"
                              ItemTemplate="{StaticResource AddressChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </WrapPanel>
        </TabControl.Tag>

        <!-- ===== Дашборд ===== -->
        <TabItem x:Name="DashboardTab" Header="Дашборд">
            <Grid Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Группы — вкладки: одним кликом, без выпадающего списка.
                         Если вкладок много, они переносятся на новую строку. -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="GroupTabs"
                                 Grid.Column="0"
                                 Margin="0,0,6,4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="GroupTabs_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                     <Setter Property="Margin" Value="0,0,6,6"/>
                                     <Setter Property="Padding" Value="14,7"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter TargetName="Bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#3B82F6" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <WrapPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   VerticalAlignment="Top"
                                   Margin="0,0,0,4">
                            <Button Content="+ Группа"
                                    Style="{StaticResource GhostButton}"
                                    Click="AddGroupButton_Click"/>
                            <Button Content="Переименовать"
                                    Style="{StaticResource GhostButton}"
                                    Click="RenameGroupButton_Click"/>
                            <Button Content="Удалить"
                                    Style="{StaticResource DangerButton}"
                                    Click="DeleteGroupButton_Click"/>
                        </WrapPanel>
                    </Grid>

                    <!-- Основные действия дашборда: главное действие выделено, опасное — с красным акцентом. -->
                    <WrapPanel Grid.Row="1"
                               Orientation="Horizontal"
                               HorizontalAlignment="Right">
                        <Button Content="Сохранить сессию"
                                MinWidth="160"
                                Margin="0,0,10,6"
                                ToolTip="Сохранить журнал выбранной группы как отдельную сессию. Мониторинг продолжится"
                                Click="SaveSessionButton_Click"/>
                        <Button x:Name="ResetStatsButton"
                                Content="Сбросить статистику"
                                Style="{StaticResource DangerOutlineButton}"
                                MinWidth="170"
                                Margin="0,0,10,6"
                                ToolTip="Очистить графики, счётчики потерь и журнал текущей сессии и начать статистику заново"
                                Click="ResetStatsButton_Click"/>
                        <Button x:Name="RefreshAllButton"
                                Content="Проверить все"
                                MinWidth="150"
                                Margin="0,0,10,6"
                                ToolTip="Заново спросить DNS и проверить все компьютеры (во всех группах)"
                                Click="RefreshButton_Click"/>
                        <Button Content="+ Компьютер"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,6"
                                Click="AddComputerButton_Click"/>
                    </WrapPanel>

                    <!-- Сводка занимает всю ширину и переносится по словам. -->
                    <TextBlock x:Name="SummaryText"
                               Grid.Row="2"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="15"
                                Margin="2,6,0,0"
                               TextWrapping="Wrap"/>

                    <!-- Вид и сортировка переносятся, если окно узкое. -->
<Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,8" Margin="0,6,0,0">
                        <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Вид"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <!-- Вид плиток переключается двумя кнопками, без выпадающего списка. -->
                        <RadioButton x:Name="ViewGraphButton"
                                     Content="График"
                                     GroupName="TileView"
                                     Tag="Graph"
                                     IsChecked="True"
                                     Style="{StaticResource SegmentButton}"
                                     Margin="0,0,6,0"
                                     Click="ViewModeButton_Click"/>
                        <RadioButton x:Name="ViewMatrixButton"
                                     Content="Матрица"
                                     GroupName="TileView"
                                     Tag="Matrix"
                                     Style="{StaticResource SegmentButton}"
                                     Margin="0,0,20,0"
                                     Click="ViewModeButton_Click"/>
                        <TextBlock Text="Сортировка"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="SortCombo"
                                  VerticalAlignment="Center"
                                  Width="280"
                                  SelectedIndex="0"
                                  SelectionChanged="SortCombo_SelectionChanged">
                            <ComboBoxItem Content="Порядок добавления"/>
                            <ComboBoxItem Content="Пинг: от меньшего к большему"/>
                            <ComboBoxItem Content="Пинг: от большего к меньшему"/>
                            <ComboBoxItem Content="Цвет: зелёные первыми"/>
                            <ComboBoxItem Content="Цвет: проблемные первыми"/>
                            <ComboBoxItem Content="Имя: А → Я"/>
                        </ComboBox>

                        <CheckBox x:Name="ShowCurrentPingCheckBox"
                                  Content="Показывать текущий пинг"
                                  VerticalAlignment="Center"
                                  Margin="24,0,0,0"
                                  ToolTip="Выключено — везде показывается только средний пинг"
                                  Click="ShowCurrentPingCheckBox_Click"/>

                        <!-- Масштаб интерфейса. То же делают Ctrl + колесо мыши и Ctrl + «+» / «-». -->
                        <TextBlock Text="Масштаб"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="24,0,6,0"/>
                        <Button Content="−" MinHeight="34" MinWidth="38" Padding="0,2"
                                ToolTip="Уменьшить (Ctrl + колесо вниз)"
                                Click="ZoomOutButton_Click"/>
                        <Button x:Name="ZoomResetButton" Content="100%"
                                Style="{StaticResource GhostButton}"
                                MinHeight="34" MinWidth="64" Padding="6,2"
                                ToolTip="Сбросить масштаб (Ctrl + 0)"
                                Click="ZoomResetButton_Click"/>
                        <Button Content="+" MinHeight="34" MinWidth="38" Padding="0,2"
                                ToolTip="Увеличить (Ctrl + колесо вверх)"
                                Click="ZoomInButton_Click"/>
                    </WrapPanel>
                    </Border>
                </Grid>

                <!-- Комбинированный график группы: средний ping и PDO на разных шкалах. -->
                <Grid Grid.Row="2" Height="130" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Padding="12,8,12,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock x:Name="GroupChartTitle" Text="ГРУППА: СРЕДНИЙ PING И PDO"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,14,2"/>
                                <TextBlock x:Name="GroupChartHoverInfo" Text="Наведи курсор на точку"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            </StackPanel>
                            <local:GroupCombinedChart x:Name="GroupCombinedChartControl" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl x:Name="TileList" Margin="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Колонки и размер плиток подбираются под ширину окна. -->
                                    <local:ResponsiveTilePanel MinTileWidth="250"
                                                               MaxTileWidth="440"
                                                               MinTileHeight="256"
                                                               HeightRatio="0.82"
                                                               Spacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TileButton}"
                                            Click="Tile_Click"
                                            ToolTip="{Binding Tooltip}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Проверить сейчас"
                                                              Click="TilePingNow_Click"/>
                                                <MenuItem Header="Подключиться по RDP"
                                                              Click="TileRdp_Click"
                                                              IsEnabled="{Binding RdpButtonEnabled}"/>
                                                <MenuItem Header="Копировать адрес"
                                                              Click="TileCopyHost_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Подробности и изменение..."
                                                              Click="TileEdit_Click"/>
                                                <MenuItem Header="Удалить компьютер"
                                                              Click="TileDelete_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="4"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Цветная полоса сверху: статус виден с первого взгляда. -->
                                            <Border Background="{Binding StateBrush}"
                                                    CornerRadius="11,11,0,0"/>

                                            <!-- Лёгкий фон, пока у компьютера нет пинга. -->
                                            <Border Grid.RowSpan="2"
                                                    IsHitTestVisible="False"
                                                    Background="#14EF4444"
                                                    CornerRadius="12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Grid Grid.Row="1" Margin="12,8,12,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Description}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- IP слева, статус с цветной точкой справа. -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding IpAddressLabel}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="8,0,0,0">
                                                        <Ellipse Width="9" Height="9"
                                                                 Fill="{Binding StatusBrush}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,1,6,0"/>
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Главное число — средний пинг; рядом — пинг последней проверки. -->
                                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AveragePeriodLabel}"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding AverageText}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="28"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="12,0,0,3">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowCurrentPing}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="СЕЙЧАС"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding LatencyText}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- С какого момента пропал пинг (или идёт онлайн) и сколько это длится. -->
                                                <Grid Grid.Row="4" Margin="0,8,0,0" HorizontalAlignment="Left">
                                                    <Border Background="{Binding StateBrush}" Opacity="0.2" CornerRadius="7"/>
                                                    <Border BorderBrush="{Binding StateBrush}" BorderThickness="1"
                                                            Opacity="0.65" CornerRadius="7"/>
                                                    <TextBlock Text="{Binding StateSinceText}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Margin="9,3,9,3"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>

                                                <TextBlock Grid.Row="5"
                                                           Text="{Binding PacketLossText}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="12"
                                                           Margin="0,6,0,0"/>

                                                <Grid Grid.Row="6" Margin="0,4,0,0" MinHeight="70" ClipToBounds="True">
                                                    <local:PingGraph Tile="{Binding}" IsHitTestVisible="False">
                                                        <local:PingGraph.Style>
                                                            <Style TargetType="local:PingGraph">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding VisualizationMode}" Value="Matrix">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </local:PingGraph.Style>
                                                    </local:PingGraph>
                                                    <local:PingMatrix Tile="{Binding}">
                                                        <local:PingMatrix.Style>
                                                            <Style TargetType="local:PingMatrix">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding VisualizationMode}" Value="Matrix">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </local:PingMatrix.Style>
                                                    </local:PingMatrix>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyText"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   MaxWidth="520"
                                   Margin="0,90,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ===== Сканер сети ===== -->
        <TabItem Header="Сканер">
            <Grid Margin="28,24,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Панель настроек: что сканируем, автосканирование и фильтры. -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16,18,10">
                    <StackPanel>
                        <TextBlock Text="ЧТО СКАНИРУЕМ" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                        <WrapPanel VerticalAlignment="Center">
                            <ComboBox x:Name="ScanTargetModeCombo"
                                      Width="190" Margin="0,0,10,8">
                                <ComboBoxItem Content="Локальная сеть" Tag="LocalNetwork"/>
                                <ComboBoxItem Content="Диапазон IP" Tag="IpRange"/>
                            </ComboBox>
                            <ComboBox x:Name="NetworkCombo"
                                      Width="340" Margin="0,0,10,8"/>
                            <StackPanel x:Name="RangeTargetPanel"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed"
                                        Margin="0,0,10,8">
                                <TextBlock Text="От" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox x:Name="RangeStartBox" Width="140"
                                         Margin="0,0,12,0"
                                         ToolTip="Начальный IPv4-адрес, например 192.168.1.1"
                                         LostFocus="ScanTargetInputs_LostFocus"/>
                                <TextBlock Text="До" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox x:Name="RangeEndBox" Width="140"
                                         ToolTip="Конечный IPv4-адрес, например 192.168.1.254"
                                         LostFocus="ScanTargetInputs_LostFocus"/>
                            </StackPanel>
                            <Button x:Name="RefreshNetworksButton"
                                    Content="Обновить сети"
                                    Margin="0,0,10,8"
                                    Click="RefreshNetworksButton_Click"/>
                            <Button x:Name="ScanButton"
                                    Content="Сканировать"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="140"
                                    Margin="0,0,10,8"
                                    Click="ScanButton_Click"/>
                            <Button x:Name="StopScanButton"
                                    Content="Остановить"
                                    Margin="0,0,0,8"
                                    IsEnabled="False"
                                    Click="StopScanButton_Click"/>
                        </WrapPanel>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4,0,14"/>

                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox x:Name="AutoScanCheckBox"
                                      Content="Автосканирование"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,8"
                                      Checked="AutoScanCheckBox_Changed"
                                      Unchecked="AutoScanCheckBox_Changed"/>
                            <TextBlock Text="Интервал, сек."
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <TextBox x:Name="AutoScanIntervalBox" Text="60"
                                     Width="72" Margin="0,0,16,8"
                                     LostFocus="AutoScanIntervalBox_LostFocus"/>
                            <TextBlock x:Name="AutoScanStatusText"
                                       Text="Автосканирование выключено"
                                       VerticalAlignment="Center"
                                       Margin="0,0,28,8"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="Фильтр"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <TextBox x:Name="FilterTextBox"
                                     Width="190" Margin="0,0,16,8"
                                     ToolTip="Поиск по имени или IP-адресу"
                                     TextChanged="FilterTextBox_TextChanged"/>
                            <CheckBox x:Name="DnsOnlyCheckBox"
                                      Content="Только с DNS-именем"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,8"
                                      Checked="ResultFilter_Changed"
                                      Unchecked="ResultFilter_Changed"/>
                            <ComboBox x:Name="MaxLatencyCombo"
                                      Width="180" Margin="0,0,0,8"
                                      SelectedValuePath="Tag"
                                      ToolTip="Ограничить результаты по времени отклика">
                                <ComboBoxItem Content="Любая задержка" Tag="0"/>
                                <ComboBoxItem Content="До 10 ms" Tag="10"/>
                                <ComboBoxItem Content="До 50 ms" Tag="50"/>
                                <ComboBoxItem Content="До 100 ms" Tag="100"/>
                                <ComboBoxItem Content="До 250 ms" Tag="250"/>
                                <ComboBoxItem Content="До 500 ms" Tag="500"/>
                            </ComboBox>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Прогресс и статус сканирования. -->
                <StackPanel Grid.Row="1" Margin="0,16,0,12">
                    <ProgressBar x:Name="ScanProgress"/>
                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <TextBlock x:Name="FilterSummaryText"
                                   DockPanel.Dock="Right"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="16,0,0,0"/>
                        <TextBlock x:Name="ScanStatusText"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1">
                    <DataGrid x:Name="ResultsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя / DNS" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="IP-адрес" Binding="{Binding IpAddress}" Width="190"/>
                            <DataGridTextColumn Header="Задержка" Binding="{Binding LatencyMs, StringFormat={}{0} ms}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Button x:Name="AddFoundButton"
                        Grid.Row="3"
                        Content="Добавить выбранные в группу..."
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0"
                        Click="AddFoundButton_Click"/>
            </Grid>
        </TabItem>

        <!-- ===== Сессии мониторинга ===== -->
        <TabItem x:Name="SessionsTab" Header="Сессии">
            <Grid Margin="28,24,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*" MinHeight="200"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" MaxWidth="560" VerticalAlignment="Center">

                        <Button Content="Текущая сессия"
                                Margin="10,0,0,0"
                                Click="ShowCurrentSessionButton_Click"/>
                        <Button Content="Обновить"
                                Margin="10,0,0,0"
                                Click="RefreshSessionsButton_Click"/>
                        <Button Content="Изменить"
                                Margin="10,0,0,0"
                                Click="EditSessionButton_Click"/>
                        <Button Content="Удалить сессию"
                                Style="{StaticResource DangerButton}"
                                Margin="10,0,0,0"
                                Click="DeleteSessionButton_Click"/>
                    </WrapPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Сохранённые сессии"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Сессия сохраняется кнопкой «Сохранить сессию» на дашборде. Новые отображаются сверху"
                                   Style="{StaticResource Hint}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                    <DataGrid x:Name="SessionsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              SelectionChanged="SessionsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding DisplayName}"
                                                SortMemberPath="Name" Width="220"/>
                            <DataGridTextColumn Header="Комментарий"
                                                Binding="{Binding Comment}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Группа"
                                                Binding="{Binding GroupName}"
                                                SortMemberPath="GroupName" Width="180"/>
                            <DataGridTextColumn Header="Начало"
                                                Binding="{Binding StartedAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                                SortMemberPath="StartedAt" Width="170"/>
                            <DataGridTextColumn Header="Завершение"
                                                Binding="{Binding EndedAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                                SortMemberPath="EndedAt" Width="170"/>
                            <DataGridTextColumn Header="Компьютеров"
                                                Binding="{Binding ComputerCount}"
                                                SortMemberPath="ComputerCount" Width="120"/>
                            <DataGridTextColumn Header="Записей"
                                                Binding="{Binding EntryCount}"
                                                SortMemberPath="EntryCount" Width="90"/>
                            <DataGridTextColumn Header="Средний ping"
                                                Binding="{Binding AverageLatencyMs, StringFormat={}{0:F0} ms}"
                                                SortMemberPath="AverageLatencyMs" Width="120"/>
                            <DataGridTextColumn Header="Потери"
                                                Binding="{Binding LossPercent, StringFormat={}{0:F1}%}"
                                                SortMemberPath="LossPercent" Width="90"/>
                            <DataGridTextColumn Header="Длительность"
                                                Binding="{Binding DurationText}"
                                                SortMemberPath="DurationText" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock x:Name="SessionViewHeaderText"
                           Grid.Row="2"
                           Margin="2,16,0,10"
                           Text="Текущая сессия"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"/>

                <TabControl Grid.Row="3">
                    <TabItem Header="Матрица и график">
                        <Grid>
                            <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="280"/>
                                <ColumnDefinition Width="3*" MinWidth="380"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,0,14,0">
                                <ItemsControl x:Name="SessionTileList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                              <local:ResponsiveTilePanel MinTileWidth="170"
                                                                         MaxTileWidth="240"
                                                                        MinTileHeight="70"
                                                                        HeightRatio="0.1"
                                                                         Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TileButton}"
                                                    Click="SessionTile_Click"
                                                    ToolTip="{Binding Tooltip}">
                                                <Grid Margin="12,8,12,10">
                                                     <StackPanel>
                                                         <StackPanel Orientation="Horizontal">
                                                             <Border Width="10" Height="10" CornerRadius="5"
                                                                     Background="{Binding StatusBrush}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,7,0"/>
                                                             <TextBlock Text="{Binding Name}"
                                                                        Foreground="{DynamicResource TextBrush}"
                                                                        FontSize="15"
                                                                        FontWeight="SemiBold"
                                                                        TextTrimming="CharacterEllipsis"/>
                                                         </StackPanel>
                                                         <TextBlock Text="{Binding StatusLabel}"
                                                                    Foreground="{DynamicResource MutedBrush}"
                                                                    FontSize="12"
                                                                    Margin="0,2,0,0"/>
                                                     </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Style="{StaticResource Card}" Grid.Column="1" Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="120"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SessionSelectedComputerText"
                                               Text="Выберите компьютер в матрице, чтобы посмотреть его график"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,10">
                                        <RadioButton x:Name="SessionViewGraphButton"
                                                     Content="График"
                                                     GroupName="SessionView"
                                                     Tag="Graph"
                                                     IsChecked="True"
                                                     Style="{StaticResource SegmentButton}"
                                                     Margin="0,0,6,0"
                                                     Click="SessionViewButton_Click"/>
                                        <RadioButton x:Name="SessionViewMatrixButton"
                                                     Content="Матрица"
                                                     GroupName="SessionView"
                                                     Tag="Matrix"
                                                     Style="{StaticResource SegmentButton}"
                                                     Margin="0,0,6,0"
                                                     Click="SessionViewButton_Click"/>
                                    </StackPanel>
                                    <Grid Grid.Row="2" MinHeight="180">
                                        <local:PingGraph x:Name="SessionGraph" UseMiniHistory="False">
                                            <local:PingGraph.Style>
                                                <Style TargetType="local:PingGraph">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SessionShowMatrix, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </local:PingGraph.Style>
                                        </local:PingGraph>
                                        <local:PingMatrix x:Name="SessionMatrix" UseMiniHistory="False">
                                            <local:PingMatrix.Style>
                                                <Style TargetType="local:PingMatrix">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SessionShowMatrix, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </local:PingMatrix.Style>
                                        </local:PingMatrix>
                                    </Grid>
                                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="8,6,8,4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Средний ping и потери пакетов сессии"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <local:GroupCombinedChart x:Name="SessionGroupCombinedChart" Grid.Row="1"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            </Grid>

                        </Grid>
                    </TabItem>
                    <TabItem Header="Журнал событий">
                        <Border Style="{StaticResource Card}" Padding="1" Margin="0,14,0,0">
                            <DataGrid x:Name="SessionRecordsGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserSortColumns="True"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время"
                                                        Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss.fff}}"
                                                        SortMemberPath="Timestamp" Width="210"/>
                                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                                    <DataGridTextColumn Header="Компьютер" Binding="{Binding ComputerName}" Width="1.3*"/>
                                    <DataGridTextColumn Header="Цель" Binding="{Binding Host}" Width="1.3*"/>
                                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="150"/>
                                    <DataGridTextColumn Header="Результат" Binding="{Binding StatusText}" Width="150"/>
                                    <DataGridTextColumn Header="Задержка" Binding="{Binding LatencyText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>

        <!-- ===== Настройки ===== -->
        <TabItem Header="Настройки">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,28,32,32" MaxWidth="760">
                    <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Параметры применяются сразу и сохраняются автоматически."
                               Style="{StaticResource Hint}"
                               Margin="0,4,0,22"/>

                    <!-- Мониторинг -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="МОНИТОРИНГ" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Интервал между циклами, мс"
                                           VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBox x:Name="PingIntervalBox" Grid.Row="0" Grid.Column="1" Margin="12,0,0,12"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="100–60000"
                                           Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="12,0,0,12"/>

                                <TextBlock Grid.Row="1" Text="Пакетов за интервал"
                                           VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBox x:Name="PacketsPerCycleBox" Grid.Row="1" Grid.Column="1" Margin="12,0,0,12"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="1–20"
                                           Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="12,0,0,12"/>

                                <TextBlock Grid.Row="2" Text="Период мини-графика и мини-матрицы, сек."
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBox x:Name="MiniHistorySecondsBox" Grid.Row="2" Grid.Column="1" Margin="12,0,0,12"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="5–3600"
                                           Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="12,0,0,12"/>

                                <TextBlock Grid.Row="3" Text="Интервал среднего пинга, сек."
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="AverageIntervalSecondsBox" Grid.Row="3" Grid.Column="1" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="1–60"
                                           Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>

                            <Button Content="Применить параметры ping"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,20,0,0"
                                    Click="ApplyMonitoringSettings_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Оформление -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Тема оформления" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" Margin="12,0,0,0"
                                          SelectionChanged="ThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Тёмная" Tag="Dark"/>
                                    <ComboBoxItem Content="Светлая" Tag="Light"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Масштаб интерфейса: Ctrl + колесо мыши или Ctrl + «+» / «−»; Ctrl + 0 — вернуть 100%."
                                       Style="{StaticResource Hint}"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Система -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="СИСТЕМА" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Content="Запускать приложение вместе с Windows обычным окном"
                                      Margin="0,0,0,14"
                                      Click="StartWithWindowsCheckBox_Click"/>
                            <CheckBox x:Name="MinimizeToTrayCheckBox"
                                      Content="Разрешить сворачивание в трей"
                                      Click="MinimizeToTrayCheckBox_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Данные -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ДАННЫЕ" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Открыть папку данных"
                                        Click="OpenDataFolder_Click"/>
                                <Button Content="Открыть папку сессий"
                                        Margin="10,0,0,0"
                                        Click="OpenSessionsFolder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SettingsStatusText"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="2,16,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
