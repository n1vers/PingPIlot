<Window x:Class="PingPilot.ComputerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PingPilot"
        Title="Подробности компьютера"
        Width="900" Height="700"
        MinWidth="650" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource AppWindow}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              CanContentScroll="False">
        
        <Grid Margin="20,16,20,16">
            <Grid.Resources>
            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="Margin" Value="0,0,20,10"/>
            </Style>
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="LegendText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0,14,0"/>
            </Style>
        </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="360"/>
            </Grid.RowDefinitions>

            <!-- ===== Заголовок ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="14" Height="14"
                         Fill="{Binding StatusBrush}"
                         VerticalAlignment="Center"
                         Margin="0,2,12,0"/>
                <TextBlock Text="{Binding Name}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding StatusLabel}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="18,4,0,0"/>
                <TextBlock Text="{Binding LatencyText}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="17"
                           VerticalAlignment="Center"
                           Margin="10,4,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding StateText}"
                       Style="{StaticResource Hint}"
                       FontSize="14"
                       Margin="26,4,0,0"/>
        </StackPanel>

        <!-- ===== Сверху: настройки и информация ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="IP-адрес или DNS-имя" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="HostInput" Margin="0,0,0,14"/>

                    <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DescriptionInput" Margin="0,0,0,14"/>

                    <TextBlock Text="Группа" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="GroupSelect"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="110"
                                Click="SaveButton_Click"/>
                        <Button Content="Проверить сейчас"
                                Margin="8,0,0,0"
                                Click="PingNowButton_Click"/>
                        <Button Content="RDP"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding RdpButtonEnabled}"
                                Click="RdpButton_Click"/>
                        <Button Content="Удалить"
                                Style="{StaticResource DangerButton}"
                                Margin="8,0,0,0"
                                Click="DeleteButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="EditStatusText"
                               Margin="0,12,0,0"
                               MinHeight="20"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ИНФОРМАЦИЯ" Style="{StaticResource SectionTitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IP-адрес" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IpAddressText}" Style="{StaticResource StatValue}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Последняя проверка" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastCheckedText}" Style="{StaticResource StatValue}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Последний раз онлайн" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastOnlineText}" Style="{StaticResource StatValue}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Проверок / получено" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SentReceivedText}" Style="{StaticResource StatValue}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Потери пакетов" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LossPercentText}" Style="{StaticResource StatValue}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Мин / средн / макс" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LatencyStatsText}" Style="{StaticResource StatValue}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="История" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding HistoryText}" Style="{StaticResource StatValue}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Снизу: график пинга ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                    <TextBlock x:Name="ViewTitle" Text="ГРАФИК ПИНГА" DockPanel.Dock="Left"
                               Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="График"
                                Style="{StaticResource GhostButton}"
                                MinHeight="32" Padding="12,4"
                                Click="OpenGraphButton_Click"/>
                        <Button Content="Матрица"
                                Style="{StaticResource GhostButton}"
                                MinHeight="32" Padding="12,4"
                                Margin="0,0,16,0"
                                Click="OpenMatrixButton_Click"/>
                        <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#22C55E" VerticalAlignment="Center"/>
                        <TextBlock Text="до 15 ms" Style="{StaticResource LegendText}"/>
                        <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#EAB308" VerticalAlignment="Center"/>
                        <TextBlock Text="до 50 ms" Style="{StaticResource LegendText}"/>
                        <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#EF4444" VerticalAlignment="Center"/>
                        <TextBlock Text="выше 50 ms" Style="{StaticResource LegendText}"/>
                        <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Text="нет ответа" Style="{StaticResource LegendText}" Margin="6,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <local:PingGraph x:Name="Graph" MinHeight="180" UseMiniHistory="False"/>
                    <local:PingMatrix x:Name="Matrix" MinHeight="320" UseMiniHistory="False" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </ScrollViewer>
</Window>
    